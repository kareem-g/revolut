# powerk — files that should never be committed

# ---- Python ----
__pycache__/
*.py[cod]
*.log

# ---- secrets ----
# tokens / passwords / local credentials (pass them on the command line instead)
*.secret
*.token
.env

# ---- Android build output ----
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/*.iml
android/captures/
*.apk
*.aab
*.keystore
*.jks

# ---- editors / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini


# runtime data (names/cost/schedules/history)
powerk-data.json
powerk-data.json.tmp

# ---- cloud (Next.js) ----
cloud/node_modules/
cloud/.next/
cloud/next-env.d.ts
cloud/tsconfig.tsbuildinfo

# ---- bridge ----
bridge/bridge.json
